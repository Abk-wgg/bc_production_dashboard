# Copy to .env.local and fill in. Never commit .env.local.
# Everything here is read server-side only. Do NOT add NEXT_PUBLIC_ to any of
# it - that would ship the client secret to the browser.
#
# The app reads BC as ITSELF (one service identity), not as each visitor, so
# adding viewers costs nothing in licences.

# --- Entra app registration (client credentials, read-only) ---
BC_TENANT_ID=8616734f-e2d9-4f2c-ad38-2c7635809074
BC_CLIENT_ID=
BC_CLIENT_SECRET=
BC_ENVIRONMENT=Production

# Company name exactly as BC shows it.
BC_COMPANY=Own Label Ceations

# --- Published web services (BC -> Web Services screen, "Service Name") ---
# All three are already published and are the built-in defaults, so you only
# need these lines to override them. See WEB-SERVICES.md.

# Production Order headers - table 5405. Default: Production_Order_List_Excel
# BC_WS_PRODUCTION_ORDERS=Production_Order_List_Excel

# Prod. Order Components - table 5407. Default: prod_order_comp_with_pick
# BC_WS_PROD_ORDER_COMPONENTS=prod_order_comp_with_pick

# Prod. Order Routing Lines - table 5409. Default: Prod_Order_Routing_Excel
# BC_WS_PROD_ORDER_ROUTING=Prod_Order_Routing_Excel

# Optional - rows requested per refresh. Default 5000.
# BC_TOP=5000

# Optional - seconds a BC response is reused before asking again. Default 60.
# BC_CACHE_SECONDS=60

# --- Sign-in (Auth.js + Microsoft Entra ID) ---
# This controls WHO MAY LOOK AT THE BOARD. It is separate from the BC values
# above: viewers sign in as themselves, the app still reads BC as itself, and a
# viewer needs no BC licence. See AUTH-SETUP.md.
#
# Uses its OWN app registration - not the BC one.

# Generate with: npx auth secret
AUTH_SECRET=

AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=

# Optional - defaults to BC_TENANT_ID. Restricting to one tenant is what stops
# any Microsoft account in the world from signing in.
# AUTH_MICROSOFT_ENTRA_ID_TENANT_ID=8616734f-e2d9-4f2c-ad38-2c7635809074

# Optional - lets Excel and Power BI call /api/* with an "x-api-key" header,
# since they cannot hold a browser session. Leave unset and the JSON feeds
# require a signed-in browser like every other page.
# BOARD_API_KEY=

# --- The rest of the chain (all published, all defaulted in code) ---
# Override any of these only if a service is renamed.

# Shop-floor output events - table 50403. Default: Prod_Order_Data_Entry_Excel
# BC_WS_OUTPUT_EVENTS=Prod_Order_Data_Entry_Excel

# Lot-level stock - table 5517495. Default: Inventory_Summary_Excel
# BC_WS_INVENTORY=Inventory_Summary_Excel

# Purchase order lines - table 39. Default: Purchase_Order_Line_Excel
# `CS_PurchaseLine` is an alternative service over the same table.
# BC_WS_PURCHASE_LINES=CS_PurchaseLine

# Sales orders - table 36. Default: sale_order_list_custom_ab
# BC_WS_SALES_ORDERS=sale_order_list_custom_ab

# Sales lines - table 37. Default: Sales_Lines_Excel
# BC_WS_SALES_LINES=Sales_Lines_Excel

# Item master - table 27. Default: Item_Card_Excel
# BC_WS_ITEMS=Item_Card_Excel
