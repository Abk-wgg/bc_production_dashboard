# Copy to .env.local and fill in. Never commit .env.local.
# Everything here is read server-side only. Do NOT add NEXT_PUBLIC_ to any of
# it - that would ship the client secret to the browser.
#
# The app reads BC as ITSELF (one service identity), not as each visitor, so
# adding viewers costs nothing in licences.

# --- Entra app registration (client credentials, read-only) ---
BC_TENANT_ID=8616734f-e2d9-4f2c-ad38-2c7635809074
BC_CLIENT_ID=
BC_CLIENT_SECRET=
BC_ENVIRONMENT=Production

# Company name exactly as BC shows it.
BC_COMPANY=Own Label Ceations

# --- Published web services (BC -> Web Services screen, "Service Name") ---
# All three are already published and are the built-in defaults, so you only
# need these lines to override them. See WEB-SERVICES.md.

# Production Order headers - table 5405. Default: Production_Order_List_Excel
# BC_WS_PRODUCTION_ORDERS=Production_Order_List_Excel

# Prod. Order Components - table 5407. Default: prod_order_comp_with_pick
# BC_WS_PROD_ORDER_COMPONENTS=prod_order_comp_with_pick

# Prod. Order Routing Lines - table 5409. Default: Prod_Order_Routing_Excel
# BC_WS_PROD_ORDER_ROUTING=Prod_Order_Routing_Excel

# Optional - rows requested per refresh. Default 5000.
# BC_TOP=5000

# Optional - seconds a BC response is reused before asking again. Default 60.
# BC_CACHE_SECONDS=60
